# Salin ke apps/<app>/.env.local (atau set di Vercel → Project → Settings → Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Hanya untuk apps/admin (JANGAN diberikan ke reader/studio)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL antar-aplikasi (untuk tautan "buka di pembaca", dsb.)
NEXT_PUBLIC_READER_URL=http://localhost:3000
NEXT_PUBLIC_STUDIO_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
